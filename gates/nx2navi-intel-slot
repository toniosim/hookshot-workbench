#!/bin/bash
# Runs a command (a game on the processor's Intel graphics) while it holds the one Intel run slot. The Intel device is a
# second Vulkan device beside the RTX 4090 (Mesa's driver, no mesh shaders, memory shared with the system), so its runs
# do not wait in the card's queue (nx2navi-gpu-slot). They are CPU load like a build, though: as a build does
# (nx2navi-build-slot), a run here waits while an exclusive timing run on the card has marked that nothing may start,
# and holds the quiet lock shared while it runs, so no timing run starts beside it.
# The game sees only the Intel device when the run sets VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json (a game
# copy's scenario.sh sets NVIDIA's file: change it in the copy that is meant for this device).
#   nx2navi-intel-slot <command> [args...]
set -euo pipefail
dir=${NX2NAVI_INTEL_SLOT_DIR:-/tmp/nx2navi-intel-slot}
gpu=${NX2NAVI_SLOT_DIR:-/tmp/nx2navi-gpu-slots}
# Other folders are for a test of the gate itself and have to say so (NX2NAVI_SLOT_TEST=1).
if [ -z "${NX2NAVI_SLOT_TEST:-}" ] && { [ "$dir" != /tmp/nx2navi-intel-slot ] || [ "$gpu" != /tmp/nx2navi-gpu-slots ]; }; then
    echo "nx2navi-intel-slot: ignoring NX2NAVI_INTEL_SLOT_DIR and NX2NAVI_SLOT_DIR (not the harness's slot folders; a test sets NX2NAVI_SLOT_TEST=1)" >&2
    dir=/tmp/nx2navi-intel-slot; gpu=/tmp/nx2navi-gpu-slots
    export NX2NAVI_INTEL_SLOT_DIR=$dir NX2NAVI_SLOT_DIR=$gpu
fi
mkdir -p "$dir" "$gpu"
# A run opens a window on the user's desktop. None is started while his compositor does not run normally: after a crash
# Hyprland comes back in safe mode, where the harness's window rules are gone and every window opens in front of him.
# NX2NAVI_SLOT_NODESKTOP=1 says that the command opens no window there (a gate holder, a headless compositor).
desktop_ok() {
    [ -n "${NX2NAVI_SLOT_NODESKTOP:-}" ] && return 0
    local p found=0
    for p in $(pgrep -x Hyprland || true); do
        found=1
        # one safe-mode instance may be allowed by the user: .nx2navi-harness/safe-mode-ok holds its process id
        if grep -qz -x -- '--safe-mode' "/proc/$p/cmdline" 2>/dev/null &&
           [ "$p" != "$(cat /home/mooki/Games/.nx2navi-harness/safe-mode-ok 2>/dev/null | tr -d '[:space:]')" ]; then
            echo "nx2navi-intel-slot: Hyprland (pid $p) runs in safe mode; the command is not started" >&2
            return 1
        fi
    done
    [ "$found" = 1 ] || { echo "nx2navi-intel-slot: no Hyprland is running; the command is not started" >&2; return 1; }
}
desktop_ok || exit 3
# The GPU guard (.nx2navi-harness/gpu-guard.sh): after a driver fault it kills the harness's programs on the card and
# writes the file "closed" into the slot folder; nothing starts while that file is there. It also kills a harness
# program that has the card open outside this gate. This gate makes sure one guard runs.
card_open() {
    local closed=${NX2NAVI_SLOT_DIR:-/tmp/nx2navi-gpu-slots}/closed
    if [ -e "$closed" ]; then
        echo "nx2navi-intel-slot: the card is closed by the GPU guard ($(head -n 1 "$closed")); the command is not started" >&2
        return 1
    fi
}
card_open || exit 4
exec 7>"$dir/0"
flock 7   # one game on the Intel device at a time
while :; do
    wanted=0
    for m in "$gpu"/quiet-wanted.*; do
        [ -e "$m" ] || continue
        if grep -qa nx2navi-gpu-slot "/proc/${m##*.}/cmdline" 2>/dev/null; then
            wanted=1
        else
            rm -f "$m"
        fi
    done
    if [ "$wanted" = 0 ]; then
        exec 8>"$gpu/quiet"
        flock -s 8
        desktop_ok || exit 3   # again: the turn may have come long after the command asked
        card_open || exit 4
        # the guard runs detached, without this gate's locks
        setsid /home/mooki/Games/.nx2navi-harness/gpu-guard.sh 9>&- 5>&- 7>&- 8>&- < /dev/null > /dev/null 2>&1 &
        export NX2NAVI_IN_INTEL_GATE=$$
        exec "$@"
    fi
    sleep 2
done
